# Copiá este archivo a .env y completá los datos de FTP (cPanel → Cuentas FTP).
# Nunca subas .env al repo.

FTP_HOST=ftp.honshitsudojo.com.ar
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/honshitsudojo.com.ar
FTP_PORT=21
# Poné 1 solo si querés sobrescribir gallery/data.json y media/ en el servidor
# FTP_SYNC_GALLERY=1
